# ---- App ----
PORT=3000
NODE_ENV=development
# Base URL used to build links in emails (verify email, reset password)
APP_BASE_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB (users, products, cart, notifications) ----
# localhost when running `npm run dev` on your machine.
# docker-compose overrides this to use the hostname "mongo".
MONGO_URI=mongodb://localhost:27017/kobomarket

# ---- PostgreSQL (all money) ----
# 5433 = the port docker-compose exposes on your machine (for `npm run dev`).
# Inside Docker, compose overrides PG_HOST to "postgres" and PG_PORT to 5432.
PG_HOST=localhost
PG_PORT=5433
PG_USER=kobo
PG_PASSWORD=change_me_local_db_password
PG_DATABASE=kobomarket

# ---- Auth (use long random strings, at least 32 characters) ----
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-000000
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-00000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- Payments (mock Paystack for now) ----
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_MODE=mock
PAYSTACK_BASE_URL=https://api.paystack.co
WEBHOOK_TARGET_URL=http://localhost:3000/api/v1/webhooks/paystack

# ---- Business rules (money is always in kobo: 100 kobo = 1 NGN) ----
# 500 basis points = 5%
COMMISSION_RATE_BPS=500
ESCROW_TIMEOUT_HOURS=72
# How often the auto-complete job runs (cron syntax)
AUTO_COMPLETE_CRON=* * * * *
# 100000 kobo = NGN 1,000
PAYOUT_MIN_KOBO=100000
