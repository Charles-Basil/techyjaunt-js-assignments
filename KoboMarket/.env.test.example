# Used by `npm test` (Jest sets NODE_ENV=test, and src/config/env.js then loads .env.test).
# Copy to .env.test:  Copy-Item .env.test.example .env.test
# Points at SEPARATE databases (kobomarket_test) on the Docker containers,
# so tests can wipe data without touching your dev data.
PORT=3001
NODE_ENV=test
APP_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/kobomarket_test

# Same user/password as in .env (the Postgres container), different database.
# The test setup creates kobomarket_test automatically if it doesn't exist.
PG_HOST=localhost
PG_PORT=5433
PG_USER=kobo
PG_PASSWORD=change_me_local_db_password
PG_DATABASE=kobomarket_test

# Test-only secrets (not used anywhere real).
JWT_ACCESS_SECRET=test-access-secret-test-access-secret-0001
JWT_REFRESH_SECRET=test-refresh-secret-test-refresh-secret-001
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Fast bcrypt for tests only (production must use >= 10)
BCRYPT_COST=4

PAYSTACK_SECRET_KEY=sk_test_mock
PAYSTACK_MODE=mock
PAYSTACK_BASE_URL=https://api.paystack.co
WEBHOOK_TARGET_URL=http://localhost:3001/api/v1/webhooks/paystack
# Mock payouts: success, or failed (accounts ending in 0000 always fail)
MOCK_TRANSFER_OUTCOME=success

COMMISSION_RATE_BPS=500
ESCROW_TIMEOUT_HOURS=72
# How often the auto-complete job runs (cron syntax)
AUTO_COMPLETE_CRON=* * * * *
PAYOUT_MIN_KOBO=100000
# How often the payout job runs (cron syntax)
PAYOUT_JOB_CRON=* * * * *
